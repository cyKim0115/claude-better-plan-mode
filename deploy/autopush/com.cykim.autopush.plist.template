<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cykim.autopush</string>

  <!-- LaunchAgent(유저 세션)여야 키체인의 GitHub 자격증명을 쓸 수 있다 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/autopush/autopush.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <!--
    커밋이 나면 바로 push한다. 커밋은 .git/logs/HEAD(reflog)에 한 줄을 남기므로
    대상 리포의 그 파일을 감시하면 launchd가 즉시 이 에이전트를 깨운다.
    WatchPaths 목록은 install.sh가 config/autopush.txt에서 생성한다.
  -->
  <key>WatchPaths</key>
  <array>
__WATCHPATHS__
  </array>

  <!-- 감시가 놓친 경우(파일 이벤트 유실, 리포 추가 직후 등)를 위한 안전망 -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/deploy/launchd/logs/autopush.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/deploy/launchd/logs/autopush.log</string>
</dict>
</plist>
