<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cykim.autopush</string>

  <!-- LaunchAgent(유저 세션)여야 키체인의 GitHub 자격증명을 쓸 수 있다 -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/deploy/autopush/autopush.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__REPO__/deploy/launchd/logs/autopush.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/deploy/launchd/logs/autopush.log</string>
</dict>
</plist>
