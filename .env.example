# .env.local로 복사해서 채우세요. .env* 는 gitignore 대상입니다.

# ── 알림 웹훅 (둘 중 하나 이상. 둘 다 있으면 양쪽으로 전송) ─────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── 원격 워커 MCP (mcp/worker.mjs) ────────────────────────────────────────────
# 필수. 16자 이상. 생성: openssl rand -hex 24
WORKER_TOKEN=
# 워커 MCP 포트 / 바인드 주소 (Tailscale IP로 좁혀도 됨)
WORKER_PORT=4000
WORKER_BIND=0.0.0.0
# 원격 에이전트에게 알려줄 보드 주소. 비우면 요청 Host의 호스트명 + PLANMODE_PORT
# 예: http://macmini-macmini:3000
WORKER_BOARD_URL=
# "0"이면 워커가 보드 서버를 직접 띄우지 않음 (launchd로 보드를 따로 띄울 때)
WORKER_SPAWN_BOARD=1
# 프로젝트 설정 파일 (기본 config/projects.json)
WORKER_PROJECTS_FILE=
# worktree 루트 (기본 ~/repo/_worktrees)
WORKER_WORKTREE_ROOT=
# "1"이면 성공한 잡의 worktree를 지우지 않음 (디버그용)
WORKER_KEEP_WORKTREE=0
# "0"이면 projects.json에 unityPath가 있어도 배치모드 컴파일 검증을 건너뜀
WORKER_UNITY_VERIFY=1

# ── 워치독 (분 단위). 멈춘 프로세스는 죽이고 잡을 실패/경고로 확정한다 ──────────
# claude 세션 전체 상한 / 이벤트 없이 멈춘 것으로 볼 시간
WORKER_CLAUDE_TIMEOUT_MIN=90
WORKER_CLAUDE_STALL_MIN=20
# Unity 배치모드 전체 상한 / 로그가 안 늘면 멈춘 것으로 볼 시간
WORKER_UNITY_TIMEOUT_MIN=45
WORKER_UNITY_STALL_MIN=10
# 화면 캡처용 GUI 에디터 전체 상한 / 로그가 안 늘면 멈춘 것으로 볼 시간
WORKER_CAPTURE_TIMEOUT_MIN=20
WORKER_CAPTURE_STALL_MIN=8
# git·gh 한 번의 상한
WORKER_GIT_TIMEOUT_MIN=10
# 프로세스도 없고 활동도 없는 running 잡을 실패로 확정하는 기준
WORKER_SWEEP_STALL_MIN=15
# 워커 세션(claude -p)이 승인 없이 쓸 수 있는 툴 (기본: git 조회·add·commit)
WORKER_CLAUDE_ALLOWED_TOOLS=
# worker_screenshot(워커 PC 화면 상태 확인)의 최대 변(px) — macOS sips로 축소.
# 잡 산출물 캡처는 이 값과 무관하다 (대상 리포의 captureMethod가 해상도를 정한다)
WORKER_SCREENSHOT_MAX_DIM=1600

# ── 보드 서버 ──────────────────────────────────────────────────────────────────
PLANMODE_PORT=3000
# dev | start (start는 사전 npm run build 필요 — 상시 운영은 start)
PLANMODE_MODE=start
